# Required for real Claude Haiku dialogue captions.
# Leave unset and pass --mock-dialogues to test the video pipeline without API calls.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-3-haiku-20240307.
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Django settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# Google Drive upload settings
# Path to your service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=
# Optional folder ID to upload videos into
GDRIVE_FOLDER_ID=
# Set true to make uploaded videos public
GDRIVE_PUBLIC=false
